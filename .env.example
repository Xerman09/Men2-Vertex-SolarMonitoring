# DeyeCloud OpenAPI Configuration
# Base URLs available depending on data center:
# - Global default: https://api.deyecloud.com
# - Europe / Africa / Asia-Pacific: https://eu1-developer.deyecloud.com
# - Americas: https://us1-developer.deyecloud.com
# - India: https://india-developer.deyecloud.com
DEYE_BASE_URL=https://api.deyecloud.com

# DeyeCloud Developer Application Credentials
# Obtain these from https://developer.deyecloud.com
DEYE_APP_ID=your_deye_app_id
DEYE_APP_SECRET=your_deye_app_secret

# DeyeCloud Account Credentials
# Note: In production, password will be SHA256-hashed automatically by the backend client
DEYE_EMAIL=your_email@example.com
DEYE_PASSWORD=your_password

# Default Station and Device SN for live telemetry
DEYE_DEFAULT_STATION_ID=SP_01
DEYE_DEFAULT_DEVICE_SN=2209X000000

# Directus Database Integration (vos_databases)
DIRECTUS_BASE_URL=https://your-directus-instance.com
DIRECTUS_API_TOKEN=your_directus_static_token_here
DIRECTUS_COLLECTION=deye_accounts

# Admin Access PIN (for unlocking administrative capabilities)
# Required in production: Set a unique, non-trivial PIN (defaults like 8888/1234 are rejected in production)
ADMIN_ACCESS_PIN=

# Application Security
# Required in production: Minimum 32-character random string for HMAC-SHA256 session cookie signing
SESSION_SECRET=
